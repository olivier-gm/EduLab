SECRET_KEY="..."
GEMINI_API_KEY="..."

# JEV (TypeSafe System One): valida que el título sea un tema real antes de
# gastar tokens de Gemini. https://docs.typesafe.ai — Si se deja vacía, el
# título se valida con Gemini como respaldo.
JEV="..."
GEMINI_CONTEXT_CACHE=true

# ── Producción: Supabase (base de datos) y Cloudflare R2 (archivos) ─────────
# Con estas variables la app no guarda NADA en el servidor y se puede mover de
# un proveedor a otro sin perder datos. Compruébalas con:
#   python tools/check_services.py
#
# Supabase → Project Settings → Database → Connection string → "Transaction
# pooler" (puerto 6543). Usa el pooler: la conexión directa es solo IPv6.
DATABASE_URL=""
DB_POOL_MAX=5
#
# Cloudflare R2 → R2 → tu bucket (privado) y "Manage R2 API Tokens" con
# permiso Object Read & Write limitado a ese bucket.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# R2_PREFIX="informes/"                          # opcional: carpeta dentro del bucket
# S3_ENDPOINT_URL="https://..."                  # otro proveedor S3 en vez de R2

# Base de datos SQLite (usuarios, documentos generados). Opcional: por
# defecto se crea "gullieth.db" en la raíz del proyecto.
DATABASE_PATH=gullieth.db

# Correos que se marcan como administradores automáticamente al registrarse
# o iniciar sesión, separados por coma. Es la única forma de dar acceso al
# panel /admin: no hay botón para "hacer admin" a otro usuario.
ADMIN_EMAILS="tu-correo@gmail.com,otro-admin@gmail.com"

# 'Continuar con Google' (OAuth 2.0). Se crean en Google Cloud Console:
# https://console.cloud.google.com/apis/credentials -> "Crear credenciales"
# -> "ID de cliente de OAuth" -> tipo "Aplicación web". El redirect URI debe
# coincidir EXACTO con el que registres ahí (en local suele ser
# http://127.0.0.1:5000/auth/google/callback). Si se deja cualquiera de las
# tres en blanco, el botón de Google simplemente no aparece y el registro
# normal (correo + contraseña) sigue funcionando igual.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:5000/auth/google/callback"

GMAIL_USER="edulab.wiki@gmail.com"
GMAIL_APP_PASSWORD="tu_contraseña_de_aplicación"